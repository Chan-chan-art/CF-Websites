---
// SearchBar.astro
---

<div class="relative w-full max-w-md block">
  <input 
    type="text" 
    id="blog-search" 
    placeholder="Type to search articles..." 
    class="w-full px-5 py-3 border border-slate-300 rounded-2xl shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700 bg-white block"
  />
</div>

<script>
  // Runs perfectly on page load
  const searchBar = document.getElementById("blog-search") as HTMLInputElement | null;
  const noResultsMsg = document.getElementById("no-results-message");
  
  if (searchBar) {
    searchBar.addEventListener("input", () => {
      const query = searchBar.value.toLowerCase().trim();
      const posts = document.querySelectorAll(".post");
      let visibleCount = 0;

      // Clean load reset when input box is completely empty
      if (query === "") {
        posts.forEach(post => {
          const htmlPost = post as HTMLElement;
          htmlPost.classList.remove("hidden");
        });
        
        if (noResultsMsg) {
          noResultsMsg.classList.add("hidden");
        }
        return;
      }

      // Instant structural filter loops
      posts.forEach(post => {
        const htmlPost = post as HTMLElement;
        const titleElement = htmlPost.querySelector(".post-title");
        const title = titleElement?.textContent?.toLowerCase() || "";

        if (title.includes(query)) {
          // Keep it/Bring it back into the grid flow instantly at the starting point
          htmlPost.classList.remove("hidden");
          visibleCount++;
        } else {
          // Drop it completely out of the grid layout grid math instantly
          htmlPost.classList.add("hidden");
        }
      });

      // No results alert panel logic management
      if (noResultsMsg) {
        if (visibleCount === 0) {
          noResultsMsg.classList.remove("hidden", "opacity-0");
          noResultsMsg.classList.add("opacity-100");
        } else {
          noResultsMsg.classList.add("hidden", "opacity-0");
          noResultsMsg.classList.remove("opacity-100");
        }
      }
    });
  }
</script>
