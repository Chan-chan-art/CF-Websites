---
import { Image } from 'astro:assets';
import { type CollectionEntry } from 'astro:content'

type Props = {
  post: CollectionEntry<"post">;
};

const { post } = Astro.props;
---

<!-- ✅ Uses transition-all with duration-300 for a crisp fade and layout rearrangement -->
<article class="post max-h-[1000px] overflow-hidden transition-all duration-300 ease-in-out hover:scale-[1.01] hover:shadow-2xl hover:shadow-teal-200/50 rounded-2xl p-4 bg-teal-50">
  <a href={`/Blog/${post.id}`}>
    <Image 
      src={post.data.image}
      width={600}
      height={600}
      alt={post.data.title}
      class="rounded-2xl shadow-xl mb-4 aspect-thumbnail object-cover" />
  </a>
  <a
     href={`/Blog/${post.id}`}
     class="text-4xl text-zinc-500 font-semibold inline-block">
     <h2 class="post-title">{post.data.title}</h2>
    </a>
    <p class="text-zinc-500 text-2xl line-clamp-2">
      {post.body}
    </p>
</article>


