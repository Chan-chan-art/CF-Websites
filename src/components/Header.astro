---
import { Image } from 'astro:assets';

// 1. Capture the active route pathname
const pathname = Astro.url.pathname;

// 2. Clean route-matching helper function
const isActive = (path: string) => {
  if (path === '/' && pathname === '/') return true;
  if (path !== '/' && pathname.startsWith(path)) return true;
  return false;
};

// 3. Centralized link map matching your exact paths
const navLinks = [
  { name: "Home", href: "/" },
  { name: "Blog", href: "/Blogs" },
  { name: "Newsletter", href: "/subscribe" },
  { name: "Playlists", href: "/playlists" },
  { name: "Contact", href: "/contact" },
];
---

<header class="px-6 md:px-20 py-4 bg-teal-100 shadow-md relative sticky top-0 z-50">
  <div class="mx-auto flex max-w-7xl items-center justify-between">
    
    <!-- Logo and site title -->
    <div class="flex-shrink-0">
      <a href="/" class="flex items-center gap-x-4">
        <Image src="/hb.webp" width={60} height={60} alt="Heartbeat Icon" class="rounded-2xl object-cover" format="webp" />
        <span class="uppercase font-bold p-4 text-teal-950">Rhythm Nation</span>
      </a>
    </div>

    <!-- Hidden Checkbox for Sidebar Toggle State -->
    <input type="checkbox" id="menu-toggle" class="peer hidden" />

    <!-- Hamburger Icon Button -->
    <label for="menu-toggle" class="md:hidden cursor-pointer flex flex-col gap-y-1.5 p-2 z-50 relative">
      <span class="w-6 h-0.5 bg-teal-900 rounded transition-all duration-300 transform raw-span-1"></span>
      <span class="w-6 h-0.5 bg-teal-900 rounded transition-all duration-300 raw-span-2"></span>
      <span class="w-6 h-0.5 bg-teal-900 rounded transition-all duration-300 transform raw-span-3"></span>
    </label>

    <!-- Navigation Sidebar Drawer -->   
    <ul class="
      /* Mobile Layout */
      fixed top-0 right-0 h-screen w-64 bg-teal-50 p-8 pt-24 shadow-2xl flex flex-col gap-y-6 z-40 transform translate-x-full transition-transform duration-300 ease-in-out
      /* Show when checkbox is checked */
      peer-checked:translate-x-0 
      /* Desktop Layout Override */
      md:static md:h-auto md:w-auto md:p-0 md:shadow-none md:flex-row md:gap-x-8 md:translate-x-0 md:bg-transparent md:flex
    ">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <li>
            <a 
              href={link.href} 
              class={`block text-lg md:text-base border-b border-teal-200 pb-2 md:border-none md:pb-0 font-bold transition-colors duration-150 relative md:py-1 ${
                active 
                  ? "text-teal-600 md:text-teal-950 font-black" 
                  : "text-teal-900 hover:text-teal-500"
              }`}
            >
              {link.name}
              {/* Subtle underline tracker under active nav item on desktop viewports */}
              {active && (
                <span class="hidden md:block absolute bottom-0 left-0 w-full h-0.5 bg-teal-900 rounded-full" />
              )}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Dark Overlay Background -->
    <label for="menu-toggle" class="fixed inset-0 bg-zinc-950/40 bg-opacity-40 z-30 hidden peer-checked:block md:peer-checked:hidden"></label>

  </div>
</header>

<style>
  /* Explicitly targeting the spans via checkbox rules */
  #menu-toggle:checked ~ label .raw-span-1 {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-toggle:checked ~ label .raw-span-2 {
    opacity: 0;
  }
  #menu-toggle:checked ~ label .raw-span-3 {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>
