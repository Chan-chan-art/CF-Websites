---
// Footer.astro
import { Icon } from "astro-icon/components";

// Automatically grab the current year on the server side (2026)
const currentYear = new Date().getFullYear();

const footerLinks = [
  {
    title: "Explore",
    links: [
      { name: "Home Feed", href: "/" },
      { name: "Blog Posts", href: "/Blogs" },
      { name: "Curated Playlists", href: "/playlists" },
    ]
  },
  {
    title: "Community",
    links: [
      { name: "Newsletter", href: "/subscribe" },
      { name: "Contact Hub", href: "/contact" },
      { name: "About Us", href: "/About" },
    ]
  }
];

const socialLinks = [
  { name: "Facebook", url: "https://facebook.com", icon: "mdi:facebook" },
  { name: "Instagram", url: "https://instagram.com", icon: "mdi:instagram" },
  { name: "YouTube", url: "https://youtube.com", icon: "mdi:youtube" }
];
---

<footer class="bg-zinc-950 text-zinc-400 pt-16 pb-8 border-t border-zinc-900 w-full block">
  <div class="max-w-6xl mx-auto px-6">
    
    <!-- Top Row: Branding and Subsections -->
    <!-- ✅ Mobile: text-center, flex-col with item centering. Desktop: grid matching left-align options -->
    <div class="flex flex-col items-center text-center md:text-left md:grid md:grid-cols-12 gap-28 pb-12 border-b border-zinc-900">
      
      <!-- Brand Profile Space (5 Columns on Desktop) -->
      <div class="md:col-span-5 flex flex-col items-center md:items-start space-y-4">
        <a href="/" class="flex items-center gap-2 group w-max">
          <div class="w-8 h-8 bg-white text-zinc-950 rounded-lg flex items-center justify-center font-black text-lg transition-transform group-hover:scale-105 duration-200">
            RN
          </div>
          <span class="text-xl font-bold tracking-tight text-white">
            Rhythm <span class="text-teal-400">Nation</span>
          </span>
        </a>
        <p class="text-zinc-500 text-base max-w-sm leading-relaxed">
          A synchronized digital stage for cross-meridian soundscapes, deep cultural dives, and curated international music audio files.
        </p>
        
        <!-- Social Channels Links -->
        <div class="flex items-center justify-center md:justify-start gap-3 pt-2">
          {socialLinks.map((link) => (
            <a 
              href={link.url} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-9 h-9 bg-zinc-900 hover:bg-zinc-800 hover:text-white text-zinc-400 rounded-xl flex items-center justify-center transition-all duration-200"
              title={`Follow Rhythm Nation on ${link.name}`}
            >
              <Icon name={link.icon} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation Links Sections (7 Columns on Desktop) -->
      <!-- ✅ Mobile: Full width layout with 2 clean columns centered text. Desktop: Lock right alignment -->
      <div class="w-full md:col-span-7 grid grid-cols-2  text-center md:text-left md:justify-items-end pt-6 md:pt-0">
        {footerLinks.map((group) => (
          <div class="w-full">
            <h4 class="text-xs uppercase font-extrabold tracking-widest text-zinc-500 mb-4">
              {group.title}
            </h4>
            <ul class="space-y-2.5">
              {group.links.map((link) => (
                <li>
                  <a 
                    href={link.href} 
                    class="text-zinc-400 hover:text-teal-400 transition-colors duration-150 font-medium text-sm md:text-base"
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>

    <!-- Bottom Row: Copyright Framework Info -->
    <!-- ✅ Mobile: Fully stacked flex column centered alignment. Desktop: Left-to-right rows split -->
    <div class="pt-8 flex flex-col items-center md:flex-row md:items-center md:justify-between gap-4 text-center md:text-left">
      <p class="text-zinc-600 text-sm">
        Copyright © {currentYear} Rhythm Nation. All rights reserved. Built with Astro & Tailwind.
      </p>
      
      <!-- Back to Top Smooth Anchor Trigger -->
      <button 
        id="scroll-to-top"
        class="text-zinc-600 hover:text-teal-400 transition-colors font-semibold text-sm flex items-center justify-center gap-1 cursor-pointer focus:outline-none"
      >
        <span>Back to top</span>
        <svg xmlns="http://w3.org" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
        </svg>
      </button>
    </div>

  </div>
</footer>

<script>
  // Smooth scroll handler fallback logic behavior execution
  const topBtn = document.getElementById("scroll-to-top");
  if (topBtn) {
    topBtn.addEventListener("click", () => {
      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    });
  }
</script>
