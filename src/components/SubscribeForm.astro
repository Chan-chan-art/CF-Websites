---
// src/components/SubscribeForm.astro
import { actions } from 'astro:actions';
import { Form } from '@/components/starwind/form';
import { Field } from '@/components/starwind/field';
import { Input } from '@/components/starwind/input';
import { Button } from '@/components/starwind/button';
import { Video } from '@/components/starwind/video';

const result = Astro.getActionResult(actions.subscribe);
---

<!-- 1. Section: Uses relative, full-screen viewport sizes, and ensures content never overflows screen bounds -->
<section class="relative w-full min-h-screen flex items-center px-6 md:px-16 lg:px-24 overflow-hidden bg-zinc-950">
  
  <!-- 2. Video: Force to stretch full-screen and cover every edge without breaking proportions -->
  <div class="absolute inset-0 w-full h-full z-0 pointer-events-none">
    <Video 
      src="/videos/55859-504238916_medium.mp4" 
      autoplay 
      loop 
      muted 
      playsinline
      preload="metadata"
      class="w-full h-full object-cover"
    />
  </div>

  <!-- 3. Dark Overlay: Keeps readability high edge-to-edge -->
  <div class="absolute inset-0 bg-black/50 z-10 pointer-events-none"></div>

  <!-- 4. Form Card Layer: Stays responsive, floats left on desktop, centers on mobile -->
  <div class="relative z-20 w-full max-w-md mx-auto md:mx-0 p-20 border border-white/10 rounded-xl bg-white/10 backdrop-blur-md shadow-2xl text-center md:text-left text-white">
    <h3 class="text-3xl font-semibold mb-4">JOIN THE NATION</h3>
    <p class="text-sm text-zinc-200 mb-6">Get weekly dispatches from the world's most vibrant sonic frontiers.</p>

    {result?.data?.success ? (
      <div class="p-4 bg-green-500/20 text-green-200 rounded-md text-sm border border-green-500/30 font-medium">
        {result.data.message}
      </div>
    ) : (
      <Form action={actions.subscribe} method="POST" class="space-y-4">
        <Field name="email">
          <label for="email" class="block text-sm font-medium text-zinc-100 mb-1">
            Email Address
          </label>
          <Input 
            type="email" 
            id="email" 
            name="email" 
            placeholder="you@example.com" 
            required 
            class="w-full text-center md:text-left bg-white/10 border-white/20 text-white placeholder-zinc-400 focus:border-white focus:ring-white" 
          />
        </Field>
        <Button type="submit" class="w-full justify-center md:justify-center bg-white text-zinc-950 hover:bg-zinc-100">
          Subscribe
        </Button>
      </Form>
    )}
  </div>
</section>
