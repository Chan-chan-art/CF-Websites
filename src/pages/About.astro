---
import Layout from "../layouts/Layout.astro"
import H1 from "../components/H1.astro"
import H3 from "../components/H3.astro"
import { Image } from 'astro:assets';
export const prerender = true;

// 1. Your data array (can come from an API, Markdown files, or hardcoded)
const items = [
  "Aretha Franklin - Chain Of Fools", "Aretha Franklin - Freeway Of Love", "Aretha Franklin - Jump To It",
  "Aretha Franklin - Jump To It", "Aretha Franklin - Natural Woman", "Aretha Franklin - Respect",
  "Ben E. King - Stand By Me", "Chairman Of The Board - Carolina Girls", "The Contours - Do You Love Me"
];

// Define how many items to show initially
const visibleCount = 3;

---
<Layout>
  <div class="bg-black p-14 text-white">
    <H1 text="About Us"/>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <Image class="rounded-2xl shadow-xl max-w-1xl"
  src="/photo-1507838153414-b4b713384a76.avif" 
  width={800} 
  height={1000} 
  alt="Rhythm"></Image>

    <p class="max-w-4xl text-lg">
     “The absolute best out there! Words can’t describe how fantastic y’all were.   Every song, every dance-it was all amazing! Our guests are still raving!” - Kristen Saban Settas & Adam Settas
      With more than 25years of traveling and entertaining music lovers of all ages, we make it our mission to create an unforgettable event every time we step on stage!
      Pro-Athletes including Brian McCann of the Atlanta Braves, Kevin Butler of the Chicago Bears and Nancy Lopez, LPGA star,  Southeastern Conference Univ of Alabama Football Coach, Nick Saban, Local TV Personalities, Fortune 500 Company CEO’s, Brides, Grooms and top event planners’ all across the country have chosen Rhythm Nation to dazzle their guests and now proudly recommend the band to their colleagues, peers and clients.
      Rhythm Nation performances blend elements of popular, timeless and recognizable musical genres which create spirited events that are enjoyed by all and happily remembered long after the event has concluded.
      Whether entertaining an intimate group of 30 or thrilling a crowd of 300,000, we deliver an energetic, musically exciting and interactive show!
    </p>
    </div>
    </div>

    <div class="p-15 w-full flex items-end">
    <div class="w-full min-h-screen ">
    
    <div class="p-4 pb-4">

    
      <p class="text-4xl font-bold">“The absolute best out there! Words can’t describe how fantastic y’all were.   Every song, every dance-it was all amazing! Our guests are still raving!”</p>
      <p class="mt-4 leading relaxed italic text-lg italic">- Kristen Saban Settas & Adam Settas</p>
   
    <ul class="my-10 list-disc list-inside space-y-3 leading-relaxed text-teal-900 word-spacing-lg">
      <li>10-piece band [4 exceptional front line vocalists, dynamic 4 piece rhythm section and 2 lively horn players]</li>
      <li>3 hour non-stop show (upon request)</li>
      <li>Special attention is always given to wardrobe, costuming, props and unique party themes</li>
      <li>Team Building “Live Band” Karaoke shows available for our corporate clients</li>
      <li>Choreographed and interactive performances at every event</li>
      <li>Musical styles include: Current Hits, R & B, Motown, Funk, Classic Rock,  Retro 70’s & 80’s, Disco, Jazz and Swing</li>
      <li>Traditional Jewish songs including the Hora [sung in Hebrew]</li>
      <li>Rhythm Nation is equipped with professional quality sound equipment and stage lighting adequate for most events</li>
      <li>Rhythm Nation will travel any where in the world; all band members hold current US Passports</li>
    </ul> 

    <p class="text-4xl text-teal-900 font-bold">..........be a part of the Rhythm Nation!</p>
    </div>
    </div>
    </div>
    


  

  <div class="w-full min-h-screen p-14 bg-slate-100">
  <div class="pt-12">
  <H1 text="VIDEOS"/>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
  <div class="pl-12 pr-12 pb-12">   
  <video 
    class="w-full max-w-2xl  aspect-video rounded-lg shadow-lg" 
    controls 
    muted 
    autoplay 
    loop
  >
    <source src="/my-video.mp4" type="video/mp4" />
    Your browser does not support the video tag.
  </video>
</div>

<div>
<div class="max-w-md mx-auto p-4 bg-slate-50 rounded-xl shadow">
  <h2 class="text-xl font-bold mb-4">MOTION/ OLDIES</h2>
  
  <ul id="item-list" class="space-y-2">
    {items.map((item, index) => (
      <li 
        class={`p-3 bg-white border border-slate-200 rounded-lg shadow-sm transition-all duration-300 ${index >= visibleCount ? 'hidden extra-item' : ''}`}
      >
        {item}
      </li>
    ))}
  </ul>

  {/* 2. The Toggle Button */}
  {items.length > visibleCount && (
    <button 
      id="toggle-btn"
      class="mt-4 w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors"
    >
      Read More
    </button>
  )}
</div>

{/* 3. Client-side Interaction script */}
<script>
  const button = document.getElementById('toggle-btn');
  const extraItems = document.querySelectorAll('.extra-item');

  if (button) {
    button.addEventListener('click', () => {
      // Check if items are currently hidden
      const isHidden = extraItems[0].classList.contains('hidden');

      extraItems.forEach(item => {
        item.classList.toggle('hidden');
      });

      // Update button text based on state
      button.textContent = isHidden ? 'Show Less' : 'Read More';
    });
  }
</script>

    <p class="my-5 max-w-md mx-auto pb-7 text-black text-lg">
      lorem ipsum dolor sit amet consectetur adipiscing elit irure lorem facilis quos animi 
      ad magna pariatur anim aut fuga corrupti imperdiet et velit reprehenderit dolorum minim 
    </p>

  </div>
  </div>
  </div>
</Layout>