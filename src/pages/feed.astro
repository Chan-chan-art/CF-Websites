---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro'; // Adjust this to match your layout path
import readingTime from 'reading-time';

const posts = await getCollection('post');
const publishedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Extract all unique categories to generate filtering tabs dynamically
const allCategories = [
  'all',
  ...new Set(publishedPosts.flatMap((post) => post.data.categories || [])),
];
---

<Layout title="Blog Feed, Categories & Search">
  <!-- ✅ STEP 1: Outer layout block wraps the whole screen in full-width slate -->
  <div class="w-full bg-slate-50 min-h-screen">
    
    <!-- ✅ STEP 2: Inner main container constrains the actual text content to max-w-6xl -->
    <main class="max-w-6xl mx-auto px-6 py-12 font-sans">
      
      <!-- Header Section -->
      <div class="border-b border-slate-200 pb-6 mb-8 text-center md:text-left">
        <h1 class="text-4xl font-extrabold tracking-tight text-slate-900 mb-2">My Astro Blog Feed</h1>
        <p class="text-lg text-slate-600 mb-6">Filter by category or type to search articles instantly.</p>
        
        <!-- Category Filtering Tabs -->
        <div class="flex flex-wrap gap-2 mb-6 justify-center md:justify-start" id="category-tabs">
          {allCategories.map((category) => (
            <button
              data-category={category.toLowerCase()}
              class="category-btn px-4 py-2 text-sm font-semibold rounded-full border border-slate-200 bg-white text-slate-600 hover:border-indigo-500 hover:text-indigo-600 transition-all cursor-pointer shadow-sm capitalize data-[active=true]:bg-indigo-600 data-[active=true]:text-white data-[active=true]:border-indigo-600"
              data-active={category === 'all' ? 'true' : 'false'}
            >
              {category}
            </button>
          ))}
        </div>

        <!-- Live Search Input Bar -->
        <div class="relative max-w-md mx-auto md:mx-0 mb-6">
          <input 
            type="text" 
            id="blog-search" 
            placeholder="Type to search articles..." 
            class="w-full px-5 py-3 border border-slate-300 rounded-2xl shadow-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-slate-700 bg-white"
          />
        </div>

        <!-- RSS Subscribe Domain Link Badge -->
        <div class="flex justify-center md:justify-start">
          <div class="inline-flex items-center gap-2 bg-indigo-50 border border-indigo-100 rounded-full px-4 py-1.5 text-sm text-indigo-700 font-medium shadow-sm">
            <span>Subscribe Link:</span>
            <a href="/rss.xml" class="font-bold underline hover:text-indigo-900">://yourdomain.com</a>
          </div>
        </div>
      </div>

      <!-- 2-Column Responsive Card Grid Container Layout -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="posts-container">
        {publishedPosts.map((post) => {
          const stats = readingTime(post.body || '');
          const readTimeText = stats.text;

          return (
            <article 
              class="blog-card bg-white rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col h-full"
              data-title={post.data.title.toLowerCase()}
              data-desc={post.data.description.toLowerCase()}
              data-categories={JSON.stringify(post.data.categories?.map(c => c.toLowerCase()) || [])}
            >
              {post.data.image && (
                <div class="w-full aspect-video shrink-0 overflow-hidden bg-slate-100 border-b border-slate-100 relative">
                  <Image 
                    src={post.data.image} 
                    width={600} 
                    height={337} 
                    alt={post.data.title}
                    class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
                  />
                </div>
              )}

              <!-- Card Content Body Padding Area -->
              <div class="p-6 flex-1 flex flex-col justify-between w-full">
                <div>
                  <h2 class="text-2xl font-bold text-slate-900 mb-2 leading-tight">
                    <a href={`/Blog/${post.id}/`} class="hover:text-indigo-600 transition-colors">
                      {post.data.title}
                    </a>
                  </h2>
                  
                  <!-- Meta Row showing Date & Reading Time -->
                  <div class="flex items-center gap-3 text-xs text-slate-400 mb-4 font-medium">
                    <span>
                      {new Date(post.data.date).toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      })}
                    </span>
                    <span class="text-slate-300">•</span>
                    <span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-semibold">
                      {readTimeText}
                    </span>
                  </div>
                  <p class="text-slate-600 leading-relaxed line-clamp-3">{post.data.description}</p>
                </div>
              </div>
            </article>
          );
        })}
        
        <p id="no-results" class="text-center text-slate-400 py-12 bg-white rounded-2xl border border-slate-100 shadow-sm w-full md:col-span-2">
          No articles found matching your criteria. 🔍
        </p>
      </div>
    </main>
  </div>
</Layout>

<!-- Combined Filtering & Search Script Engine -->
<script>
  function initializeFilters() {
    const searchInput = document.getElementById('blog-search') as HTMLInputElement;
    const tabButtons = document.querySelectorAll('.category-btn') as NodeListOf<HTMLButtonElement>;
    const cards = document.querySelectorAll('.blog-card') as NodeListOf<HTMLElement>;
    const noResultsMessage = document.getElementById('no-results') as HTMLElement;

    if (!searchInput) return;

    let activeCategory = 'all';

    function filterPosts() {
      const searchValue = searchInput.value.toLowerCase().trim();
      let visibleCardsCount = 0;

      cards.forEach((card) => {
        const title = card.getAttribute('data-title') || '';
        const desc = card.getAttribute('data-desc') || '';
        const postCategories = JSON.parse(card.getAttribute('data-categories') || '[]');

        const matchesCategory = activeCategory === 'all' || postCategories.includes(activeCategory);
        const matchesSearch = title.includes(searchValue) || desc.includes(searchValue);

        if (matchesCategory && matchesSearch) {
          card.style.display = 'flex';
          visibleCardsCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCardsCount === 0) {
        noResultsMessage.style.display = 'block';
      } else {
        noResultsMessage.style.display = 'none';
      }
    }

    searchInput.addEventListener('input', filterPosts);

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabButtons.forEach((b) => b.setAttribute('data-active', 'false'));
        btn.setAttribute('data-active', 'true');
        
        activeCategory = btn.getAttribute('data-category') || 'all';
        filterPosts();
      });
    });
  }

  initializeFilters();
  document.addEventListener('astro:page-load', initializeFilters);
</script>
